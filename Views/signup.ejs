<!DOCTYPE html>
<html>
    <head>
        <title>Sign up</title>
    </head>

    <body>

        <h1>Sign up!</h1>

        <form action="/signup" method="POST">
        
        <input
            type="text"
            name="user_id"
            placeholder = "Enter your UserID">


        <input
            type="text"
            name="name"
            placeholder = "Enter your name">

        <input
            type="password"
            name="password"
            placeholder = "Enter your password">

        <button type="submit">Sign up

        </button>

    </form>
    </body>

</html>